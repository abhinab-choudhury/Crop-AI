# http://expo.dev/
# For local dev with a physical device over LAN:
EXPO_PUBLIC_SERVER_URL="http://<device-ip>:3000"
# For tunnel mode (use when LAN is not available):
# Run with: pnpm dev:tunnel
EXPO_PUBLIC_ML_SERVER_URL=""

# Plant-disease ONNX model. Download-once, cached locally, then fully offline.
# Leave unset (or comment out) to use the bundled default hosted model file.
# Set your own hosted URL (ML server, S3, GitHub releases, etc.) to override:
# EXPO_PUBLIC_DISEASE_MODEL_URL="https://example.com/resnet9_plant_disease.onnx"
