PORT="3000"
DATABASE_URL="mongodb://localhost:27017/crop-ai"
CORS_ORIGIN="http://<device-ip>:8081"
ML_SERVER="http://localhost:5000"
OPENWEATHER_KEY="" # openweathermap.org
TAVILY_API_KEY="" # https://app.tavily.com/home

# JWT auth (OTP-only login: send-otp -> verify-otp -> tokens)
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_VERIFY_EXPIRES_IN="10m"

# Mailpit (docker) - SMTP + web UI at http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Crop AI <no-reply@crop-ai.local>"

# Deep link base for verify-email link in OTP email
# Default: cropai:/// (works with expo-dev-client / standalone builds)
# For Expo Go: exp://<device-ip>:8081/--/
AUTH_LINK_BASE="cropai:///"